<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Modules inherit url and scm unchanged: without these attributes Maven appends the module name. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
		child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>io.github.peppe-git</groupId>
	<artifactId>mcp-authorization-server-parent</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>MCP Authorization Server (parent)</name>
	<description>Parent POM of mcp-authorization-server, an OAuth 2.1 authorization server for remote MCP
		servers, as a Spring Boot starter.</description>
	<url>https://github.com/peppe-git/mcp-authorization-server</url>
	<inceptionYear>2026</inceptionYear>

	<licenses>
		<license>
			<name>Apache-2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<!-- Contacts go through GitHub only: no e-mail address in the POM. -->
	<developers>
		<developer>
			<id>peppe-git</id>
			<name>Giuseppe Picciocchi</name>
			<url>https://github.com/peppe-git</url>
		</developer>
	</developers>

	<scm child.scm.connection.inherit.append.path="false"
			child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
		<connection>scm:git:https://github.com/peppe-git/mcp-authorization-server.git</connection>
		<developerConnection>scm:git:https://github.com/peppe-git/mcp-authorization-server.git</developerConnection>
		<url>https://github.com/peppe-git/mcp-authorization-server</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/peppe-git/mcp-authorization-server/issues</url>
	</issueManagement>

	<modules>
		<module>mcp-authorization-server-spring-boot-starter</module>
		<module>samples/sample-mcp-server</module>
	</modules>

	<properties>
		<!-- Baseline: Java 17 (ADR-0005). Built and tested on JDK 21. -->
		<java.version>17</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Release plugins (profile "release"); versions checked on Maven Central. Source and javadoc
		     plugin versions come from the Spring Boot parent (3.4.0 and 3.12.0). -->
		<maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
		<central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<compilerArgs>
							<arg>-Xlint:all,-processing,-serial,-options</arg>
						</compilerArgs>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<profiles>
		<!-- Publication to Maven Central: ./mvnw -Prelease deploy (see RELEASING.md). Sources, javadoc and
		     GPG signatures are required by Central. autoPublish=false: the upload is only validated, and
		     publication is confirmed by hand on central.sonatype.com. -->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<release>${java.version}</release>
							<quiet>true</quiet>
							<!-- Every doclint check but "missing comment" stays on, and fails the build on errors. -->
							<doclint>all,-missing</doclint>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>${maven-gpg-plugin.version}</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
						<configuration>
							<!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; never prompt in CI. -->
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>${central-publishing-maven-plugin.version}</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>false</autoPublish>
							<waitUntil>validated</waitUntil>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
